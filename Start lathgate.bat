@echo off
cd /d "%USERPROFILE%\Desktop\lathgate.gg"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$h = New-Object System.Net.HttpListener; $h.Prefixes.Add('http://+:8000/'); $h.Start(); Write-Host 'Lathgate.gg server running on LAN! Close this window to stop.'; while ($h.IsListening) { $c = $h.GetContext(); $u = $c.Request.Url.LocalPath.TrimStart('/'); if ($u -eq '' -or $u -eq '/') { $u = 'lathgategg.htm' }; if ($u -eq 'favicon.ico') { $u = 'fox.png' }; $p = Join-Path $PWD $u; if (Test-Path $p -PathType Leaf) { $c.Response.ContentType = if ($p -like '*.png') { 'image/png' } elseif ($p -like '*.jpg') { 'image/jpeg' } else { 'text/html; charset=utf-8' }; $b = [IO.File]::ReadAllBytes($p); $c.Response.ContentLength64 = $b.Length; $c.Response.OutputStream.Write($b, 0, $b.Length) } else { $c.Response.StatusCode = 404 }; $c.Response.Close() }"
